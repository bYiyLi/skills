#!/usr/bin/env python3
from pathlib import Path
import json
import os
import sys

sys.dont_write_bytecode = True

sys.path.insert(0, str(Path(__file__).resolve().parent))

from nexum_browser.launcher import prepare_argv, select_session

if __name__ == "__main__":
    try:
        argv, session = select_session(prepare_argv(sys.argv[1:]))
    except (RuntimeError, ValueError) as exc:
        print(json.dumps({
            "code": "invalid_request",
            "message": str(exc),
            "retryable": False,
        }))
        raise SystemExit(1)
    if session:
        os.environ["NEXUM_BROWSER_SESSION"] = session
    else:
        os.environ.pop("NEXUM_BROWSER_SESSION", None)

    from nexum_browser.cli import main

    raise SystemExit(main(argv))
